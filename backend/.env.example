PORT=8080
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Local Docker MySQL (default showcase setup)
# ---------------------------------------------------------------------------
# 1. cp backend/.env.example backend/.env
# 2. cd backend && docker compose up -d
# Values below work out of the box — no edits required for a local demo.
MYSQL_ROOT_PASSWORD=niers_root_local
MYSQL_HOST=localhost
MYSQL_USER=niers
MYSQL_PASSWORD=niers_local
MYSQL_DATABASE=niers
MYSQL_PORT=3306

# ---------------------------------------------------------------------------
# Deployment PostgreSQL / Supabase (optional — not used for local Docker)
# ---------------------------------------------------------------------------
# DB_DIALECT=postgres
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# PGSSLMODE=require
# PG_POOL_MAX=5
# SKIP_OPERATIONAL_DEMO_SEEDS=true

# ---------------------------------------------------------------------------
# Auth (dev-only secrets — replace before any public deployment)
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=niers_dev_access_secret_min_32_chars
JWT_REFRESH_SECRET=niers_dev_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Demo accounts (created on backend startup — see docs/demo-accounts.md)
# ---------------------------------------------------------------------------
SYSTEM_ADMIN__EMAIL=admin@example.com
SYSTEM_ADMIN_PASSWORD=ChangeMeAdmin123
SYSTEM_ADMIN_NAME=System Admin
SYSTEM_ADMIN_PHONE=01700000000

DEMO_REP_PASSWORD=ChangeMeDemoRep123
DEMO_DISPATCHER_PASSWORD=ChangeMeDispatcher123
DEMO_CITIZEN_PASSWORD=ChangeMeCitizen123

# ---------------------------------------------------------------------------
# Optional integrations (leave empty for local showcase)
# ---------------------------------------------------------------------------
# GPS → admin-area resolution (Barikoi). Seeded locations work without this.
BARIKOI_API_KEY=

# Outbound email — disabled by default; queue requires Redis (started via Docker).
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

REDIS_HOST=localhost
REDIS_PORT=6379
EMAIL_QUEUE_ENABLED=false
EMAIL_QUEUE_CONCURRENCY=2
EMAIL_QUEUE_ATTEMPTS=3
EMAIL_QUEUE_BACKOFF_MS=60000
